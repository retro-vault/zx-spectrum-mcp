        },
        {
            "label": "build (debug, sanitizers)",
            "type": "shell",
            "command": "make debug",
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "test",
            "type": "shell",
            "command": "make test",
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "list tools",
            "type": "shell",
            "command": "make list-tools",
            "problemMatcher": []
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "make distclean",
            "problemMatcher": []
        }
    ]
}
